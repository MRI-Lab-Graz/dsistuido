# Copy this file to ntfy.env (same directory) and keep it private.
#   cp scripts/web_settings/ntfy.env.example scripts/web_settings/ntfy.env
#
# Enables push notifications (via ntfy.sh, https://ntfy.sh) when a "full"
# pipeline or connectometry run finishes - not for --dry_run/--pilot
# pipeline runs or --dry-run/--test connectometry runs. See gui.py's
# _notify_job_finished / api_run_pipeline / api_run_connectometry.
#
# ntfy.sh topics are unauthenticated by default: anyone who knows the topic
# name can publish to it or subscribe and read your messages. Use a long,
# random, unguessable name, e.g. generate one with:
#   echo "dsi-studio-$(openssl rand -hex 16)"
#
# Then subscribe to receive the push notifications, either:
#   - install the ntfy app (iOS/Android) and add this topic, or
#   - open https://ntfy.sh/<your-topic> in a browser and leave it open, or
#   - run: ntfy subscribe <your-topic>   (if you have the ntfy CLI)

NTFY_TOPIC=dsi-studio-changeme
# NTFY_SERVER=https://ntfy.sh   # uncomment + change to use a self-hosted ntfy server instead
